{
  "note": "JS files whose behaviour the Java core must reproduce bit for bit. When one changes, update the Java counterpart, run `npm run golden`, and commit both. Presentation code (rendering, textures, UI, animation) is not listed.",
  "rules": [
    { "js": "src/movement.js", "java": "core/src/main/java/blockbyblock/core/entity/Movement.java", "covers": "stepPlayer physics, crouch, sprint, jump" },
    { "js": "src/player-settings.js", "java": "core/src/main/java/blockbyblock/core/entity/Movement.java", "covers": "speed/size scale inputs; jumpVelocityForHeight stays JS (it uses Math.log) and is passed in as an input" },
    { "js": "src/voxel-world.js", "java": "core/src/main/java/blockbyblock/core/world/", "covers": "terrain edits, box queries, support, movePlayer, raycast" },
    { "js": "src/fluid-system.js", "java": "core/src/main/java/blockbyblock/core/world/WorldFluids.java", "covers": "water flow" },
    { "js": "src/block-shapes.js", "java": "core/src/main/java/blockbyblock/core/world/shape/BlockGeometry.java", "covers": "collision and selection boxes" },
    { "js": "src/block-types.js", "java": "core/src/main/java/blockbyblock/core/world/shape/BlockDefinition.java", "covers": "block registry: ids, shapes, solid, opaque" },
    { "js": "src/stone-content.js", "java": "core/src/main/java/blockbyblock/core/world/shape/BlockDefinition.java", "covers": "registers stone variants" },
    { "js": "src/mining-content.js", "java": "core/src/main/java/blockbyblock/core/world/shape/BlockDefinition.java", "covers": "registers ores and minerals" }
  ]
}
